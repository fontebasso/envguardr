{
  "name": "envguardr",
  "description": "Validate environment variables against a declarative YAML schema in any language, CI or deploy, without ever printing their values.",
  "keywords": [
    "cli",
    "env",
    "environment",
    "environment-variables",
    "validation",
    "validator",
    "schema",
    "config",
    "runtime-config",
    "ci",
    "cd",
    "cicd",
    "devops",
    "docker",
    "fail-fast",
    "yaml",
    "kubernetes",
    "secrets"
  ],
  "version": "3.1.8",
  "private": false,
  "type": "module",
  "author": "Samuel Fontebasso",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:new-major": "node scripts/docs-new-major.mjs",
    "format": "prettier --write ./src ./tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "tsx bin/cli.ts validate ./tests/fixtures/app.schema.yaml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fuzz:validate": "node fuzz/validate.fuzz.js",
    "fuzz:schema": "node fuzz/schema.fuzz.js",
    "fuzz:yaml": "node fuzz/yaml.fuzz.js",
    "fuzz": "npm run build && node fuzz/validate.fuzz.js && node fuzz/schema.fuzz.js && node fuzz/yaml.fuzz.js"
  },
  "bin": {
    "envguardr": "./dist/bin/cli.js"
  },
  "files": [
    "dist/"
  ],
  "directories": {
    "test": "tests"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fontebasso/envguardr.git"
  },
  "bugs": {
    "url": "https://github.com/fontebasso/envguardr/issues"
  },
  "homepage": "https://github.com/fontebasso/envguardr#readme",
  "dependencies": {
    "re2js": "^2.8.6",
    "valitype": "3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "marked": "^18.1.0",
    "prettier": "^3.8.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
